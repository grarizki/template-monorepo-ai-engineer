FROM python:3.10-slim AS builder
WORKDIR /app
COPY apps/api/requirements.txt .
RUN uv add --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.10-slim
WORKDIR /app
COPY --from=builder /install /usr/local
COPY apps/api/ .
EXPOSE 8000
CMD ["uvicorn", "ai_template.server:app", "--host", "0.0.0.0", "--port", "8000"]
