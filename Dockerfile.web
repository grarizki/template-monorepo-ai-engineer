FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm
COPY apps/web/package.json apps/web/pnpm-lock.yaml* ./
RUN pnpm install
COPY apps/web/ .
RUN pnpm build

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json .
EXPOSE 4321
CMD ["node", "dist/server/entry.mjs"]
