---
import Base from "../../layouts/Base.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

let stocks: any[] = [];
let total = 0;

try {
  const res = await fetch(`${API_BASE}/stocks/?page=1&page_size=100`);
  const data = await res.json();
  stocks = data.stocks || [];
  total = data.total || 0;
} catch (_e) {}
---

<Base title="Stocks">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Stocks</h1>
    <span class="text-gray-500 text-sm">{total} total</span>
  </div>

  {stocks.length === 0 ? (
    <p class="text-gray-500">No stocks yet. Seed via <code class="bg-gray-800 px-1 rounded">POST /stocks/seed</code>.</p>
  ) : (
    <div class="bg-gray-900 rounded-lg border border-gray-800 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-800 text-gray-400">
            <th class="text-left px-4 py-3">Ticker</th>
            <th class="text-left px-4 py-3">Name</th>
            <th class="text-left px-4 py-3">Sector</th>
            <th class="text-right px-4 py-3">Price</th>
          </tr>
        </thead>
        <tbody>
          {stocks.map((s: any) => (
            <tr class="border-b border-gray-800 last:border-0 hover:bg-gray-800/50 transition">
              <td class="px-4 py-3">
                <a href={`/stocks/${s.ticker}`} class="text-blue-400 hover:underline font-mono font-bold">{s.ticker}</a>
              </td>
              <td class="px-4 py-3">{s.name}</td>
              <td class="px-4 py-3 text-gray-400">{s.sector || '-'}</td>
              <td class="px-4 py-3 text-right text-green-400">{s.current_price ? `Rp ${s.current_price.toLocaleString()}` : '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Base>
