---
import Base from "../layouts/Base.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

let projects = [];
let models = [];
let deployments = [];

try {
  const [pRes, mRes, dRes] = await Promise.all([
    fetch(`${API_BASE}/api/v1/projects`),
    fetch(`${API_BASE}/api/v1/models`),
    fetch(`${API_BASE}/api/v1/deployments`),
  ]);
  projects = await pRes.json();
  models = await mRes.json();
  deployments = await dRes.json();
} catch (e) {
  // API not running
}
---

<Base title="Dashboard">
  <h1 class="text-3xl font-bold mb-8">Dashboard</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Projects</p>
      <p class="text-4xl font-bold text-white">{projects.length}</p>
    </div>
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Models</p>
      <p class="text-4xl font-bold text-white">{models.length}</p>
    </div>
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Deployments</p>
      <p class="text-4xl font-bold text-white">{deployments.length}</p>
    </div>
  </div>

  <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
    <h2 class="text-xl font-semibold mb-4">Quick Start</h2>
    <pre
      class="bg-gray-950 rounded p-4 text-sm text-gray-300 overflow-x-auto"><code>cd apps/api
uv add -r requirements.txt
alembic upgrade head
python -m ai_template.cli demo --model demo_model</code></pre>
  </div>
</Base>
