---
import Base from "../layouts/Base.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

let stocks = [];
let stockCount = 0;

try {
  const res = await fetch(`${API_BASE}/stocks/?page=1&page_size=100`);
  const data = await res.json();
  stocks = data.stocks || [];
  stockCount = data.total || 0;
} catch (_e) {}
---

<Base title="Dashboard">
  <h1 class="text-3xl font-bold mb-8">Dashboard</h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Total Stocks</p>
      <p class="text-4xl font-bold text-white">{stockCount}</p>
    </div>
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Sectors</p>
      <p class="text-4xl font-bold text-white">{new Set(stocks.map((s: any) => s.sector).filter(Boolean)).size}</p>
    </div>
    <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
      <p class="text-gray-400 text-sm">Avg Price</p>
      <p class="text-4xl font-bold text-white">Rp {(stocks.reduce((sum: number, s: any) => sum + (s.current_price || 0), 0) / (stocks.length || 1)).toFixed(0)}</p>
    </div>
  </div>

  <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
    <h2 class="text-xl font-semibold mb-4">Quick Start</h2>
    <pre
      class="bg-gray-950 rounded p-4 text-sm text-gray-300 overflow-x-auto"><code># Seed stocks
curl -X POST http://localhost:8000/stocks/seed

# List stocks
curl http://localhost:8000/stocks/

# Get by ticker
curl http://localhost:8000/stocks/BBCA</code></pre>
  </div>
</Base>
