---
import Base from "../../layouts/Base.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
const { id } = Astro.params;

let project = null;
try {
  const res = await fetch(`${API_BASE}/api/v1/projects/${id}`);
  project = await res.json();
} catch (_e) {}
---

<Base title={project?.name || 'Project'}>
  {project ? (
    <>
      <a href="/projects" class="text-gray-500 hover:text-white text-sm mb-4 inline-block">&larr; Back</a>
      <h1 class="text-3xl font-bold mb-2">{project.name}</h1>
      <p class="text-gray-400 mb-6">{project.description || 'No description'}</p>
      <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
        <pre class="text-sm text-gray-300">{JSON.stringify(project, null, 2)}</pre>
      </div>
    </>
  ) : (
    <p class="text-gray-500">Project not found.</p>
  )}
</Base>
