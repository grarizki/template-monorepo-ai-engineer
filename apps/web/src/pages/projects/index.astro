---
import Base from '../../layouts/Base.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

let projects = [];
try {
  const res = await fetch(`${API_BASE}/api/v1/projects`);
  projects = await res.json();
} catch (e) {}
---

<Base title="Projects">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Projects</h1>
  </div>

  {projects.length === 0 ? (
    <p class="text-gray-500">No projects yet. Create one via the API.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {projects.map((p: any) => (
        <a href={`/projects/${p.id}`} class="block bg-gray-900 rounded-lg p-6 border border-gray-800 hover:border-gray-700 transition">
          <h2 class="text-lg font-semibold mb-2">{p.name}</h2>
          <p class="text-gray-400 text-sm">{p.description || 'No description'}</p>
          <p class="text-gray-600 text-xs mt-4">{p.created_at}</p>
        </a>
      ))}
    </div>
  )}
</Base>
