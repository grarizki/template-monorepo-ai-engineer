---
const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";
const { id } = Astro.params;

let _model = null;
try {
  const res = await fetch(`${API_BASE}/api/v1/models/${id}`);
  _model = await res.json();
} catch (_e) {}
---

<Base title={model?.name || 'Model'}>
  {model ? (
    <>
      <a href="/models" class="text-gray-500 hover:text-white text-sm mb-4 inline-block">&larr; Back</a>
      <h1 class="text-3xl font-bold mb-2">{model.name}</h1>
      <p class="text-gray-400 mb-6">{model.description || 'No description'}</p>
      <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
        <pre class="text-sm text-gray-300">{JSON.stringify(model, null, 2)}</pre>
      </div>
    </>
  ) : (
    <p class="text-gray-500">Model not found.</p>
  )}
</Base>
