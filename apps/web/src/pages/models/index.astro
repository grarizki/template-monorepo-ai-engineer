---
import Base from "../../layouts/Base.astro";

const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8000";

let models: any[] = [];
try {
  const res = await fetch(`${API_BASE}/api/v1/models`);
  models = await res.json();
} catch (_e) {}
---

<Base title="Models">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">Models</h1>
  </div>
  {models.length === 0 ? (
    <p class="text-gray-500">No models yet.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {models.map((m: any) => (
        <div class="bg-gray-900 rounded-lg p-6 border border-gray-800">
          <h2 class="text-lg font-semibold mb-2">{m.name}</h2>
          <p class="text-gray-400 text-sm">{m.description || 'No description'}</p>
          {m.metrics && (
            <div class="mt-4 flex gap-4 text-xs">
              <span class="text-green-400">acc: {(m.metrics.accuracy * 100).toFixed(1)}%</span>
              <span class="text-red-400">loss: {m.metrics.loss?.toFixed(3)}</span>
            </div>
          )}
        </div>
      ))}
    </div>
  )}
</Base>
